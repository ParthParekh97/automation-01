# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPER_ADMIN_EMAIL=admin@yourdomain.com

# Twilio (calls + SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SendGrid (email)
SENDGRID_API_KEY=

# Cal.com (bookings)
CALCOM_API_KEY=

# Vapi (AI voice calls)
VAPI_API_KEY=your-vapi-api-key
VAPI_ASSISTANT_ID=your-vapi-assistant-id
VAPI_WEBHOOK_SECRET=your-vapi-webhook-secret
# Fallback client_id when none is found in call.metadata.client_id
VAPI_DEFAULT_CLIENT_ID=

# Google OAuth / Gmail
# Create credentials at: console.cloud.google.com → APIs & Services → Credentials
# Enable: Gmail API. Add redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Token encryption — generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Cron job secret — set the same value in Vercel project settings
CRON_SECRET=

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Anthropic (Claude AI for email sequences)
ANTHROPIC_API_KEY=

# Stripe (payments - future)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
